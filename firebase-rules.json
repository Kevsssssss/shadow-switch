{
  "rules": {
    "admin_config": {
      ".read": true,
      ".write": true
    },
    "heartbeats": {
      ".read": true,
      "$machine_id": {
        ".write": "auth != null" 
      }
    },
    "commands": {
      "$machine_id": {
        ".read": "auth != null",
        ".write": "newData.isString() && (newData.val() == 'shutdown' || newData.val() == 'restart' || newData.val() == 'logout' || newData.val() == 'lock')"
      }
    }
  }
}
